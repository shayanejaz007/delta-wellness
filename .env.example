# Public site URL, used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://deltawellness.ai

# Set to 1 to play the hero video. Unset shows the gradient only.
NEXT_PUBLIC_HERO_VIDEO=1

# --- Contact / consultation form delivery (Resend) ------------------------
# API key from https://resend.com/api-keys. Never commit a real key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@deltawellness.ai

# Visible sender. MUST be on a domain verified in Resend.
CONTACT_FROM_EMAIL=noreply@deltawellness.ai

# Optional: separate no-reply sender for the visitor acknowledgement.
# Falls back to CONTACT_FROM_EMAIL.
CONTACT_NOREPLY_EMAIL=noreply@deltawellness.ai
